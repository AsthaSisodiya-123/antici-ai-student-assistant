<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080A12"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PERSONAL WORKSPACE"
            android:textColor="#6F7893"
            android:textSize="11sp"
            android:letterSpacing="0.12" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="New exam."
            android:textColor="#F5F7FF"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Add an exam so AnticiAI can track your preparation."
            android:textColor="#858DA5"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etExamTitle"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_main_card"
            android:hint="Exam title"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:textColor="#F5F7FF"
            android:textColorHint="#6F7893"
            android:textSize="15sp" />

        <!-- SUBJECT -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="SUBJECT"
            android:textColor="#858DA5"
            android:textSize="11sp"
            android:letterSpacing="0.1" />

        <Spinner
            android:id="@+id/spinnerSubject"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_main_card"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <!-- EXAM TYPE -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="EXAM TYPE"
            android:textColor="#858DA5"
            android:textSize="11sp"
            android:letterSpacing="0.1" />

        <Spinner
            android:id="@+id/spinnerExamType"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_main_card"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <!-- DATE -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="EXAM DATE"
            android:textColor="#858DA5"
            android:textSize="11sp"
            android:letterSpacing="0.1" />

        <TextView
            android:id="@+id/tvExamDate"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_main_card"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:text="Select exam date"
            android:textColor="#858DA5"
            android:textSize="15sp"
            android:clickable="true"
            android:focusable="true" />

        <!-- TIME -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="EXAM TIME"
            android:textColor="#858DA5"
            android:textSize="11sp"
            android:letterSpacing="0.1" />

        <TextView
            android:id="@+id/tvExamTime"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_main_card"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:text="Select exam time"
            android:textColor="#858DA5"
            android:textSize="15sp"
            android:clickable="true"
            android:focusable="true" />

        <!-- ROOM -->

        <EditText
            android:id="@+id/etRoom"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_main_card"
            android:hint="Exam room"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:textColor="#F5F7FF"
            android:textColorHint="#6F7893"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnAddExam"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:backgroundTint="#4D8DFF"
            android:text="ADD EXAM"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>