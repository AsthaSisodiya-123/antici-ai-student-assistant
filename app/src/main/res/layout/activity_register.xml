<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080A12"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="30dp"
        android:paddingBottom="35dp">


        <!-- Header -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvBack"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="←  BACK"
                android:textColor="#6F7893"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="01 / 02"
                android:textColor="#4D8DFF"
                android:textSize="10sp"
                android:letterSpacing="0.12"/>

        </LinearLayout>


        <!-- Heading -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="42dp"
            android:text="Create your&#10;AnticiAI profile."
            android:textColor="#F5F7FF"
            android:textSize="34sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingExtra="3dp"
            android:text="Tell us a little about yourself. We'll use this information to personalize your experience."
            android:textColor="#858DA5"
            android:textSize="14sp"/>


        <!-- Section -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:text="PERSONAL INFORMATION"
            android:textColor="#4D8DFF"
            android:textSize="10sp"
            android:letterSpacing="0.14"/>


        <!-- Full name -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="FULL NAME"
            android:textColor="#6F7893"
            android:textSize="10sp"
            android:letterSpacing="0.1"/>

        <EditText
            android:id="@+id/etName"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_login_input"
            android:hint="Your full name"
            android:inputType="textPersonName"
            android:paddingStart="17dp"
            android:paddingEnd="17dp"
            android:textColor="#F5F7FF"
            android:textColorHint="#555D73"
            android:textSize="14sp"/>


        <!-- Email -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="EMAIL ADDRESS"
            android:textColor="#6F7893"
            android:textSize="10sp"
            android:letterSpacing="0.1"/>

        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_login_input"
            android:hint="you@example.com"
            android:inputType="textEmailAddress"
            android:paddingStart="17dp"
            android:paddingEnd="17dp"
            android:textColor="#F5F7FF"
            android:textColorHint="#555D73"
            android:textSize="14sp"/>


        <!-- Mobile -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="MOBILE NUMBER"
            android:textColor="#6F7893"
            android:textSize="10sp"
            android:letterSpacing="0.1"/>

        <EditText
            android:id="@+id/etMobile"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_login_input"
            android:hint="+91  XXXXX XXXXX"
            android:inputType="phone"
            android:paddingStart="17dp"
            android:paddingEnd="17dp"
            android:textColor="#F5F7FF"
            android:textColorHint="#555D73"
            android:textSize="14sp"/>


        <!-- Academic -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:text="ACADEMIC INFORMATION"
            android:textColor="#4D8DFF"
            android:textSize="10sp"
            android:letterSpacing="0.14"/>


        <!-- College -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="COLLEGE / INSTITUTE"
            android:textColor="#6F7893"
            android:textSize="10sp"
            android:letterSpacing="0.1"/>

        <EditText
            android:id="@+id/etCollege"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_login_input"
            android:hint="Your college or institute"
            android:inputType="textCapSentences"
            android:paddingStart="17dp"
            android:paddingEnd="17dp"
            android:textColor="#F5F7FF"
            android:textColorHint="#555D73"
            android:textSize="14sp"/>


        <!-- Course + Year -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="COURSE"
                    android:textColor="#6F7893"
                    android:textSize="10sp"
                    android:letterSpacing="0.1"/>

                <EditText
                    android:id="@+id/etCourse"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/bg_login_input"
                    android:hint="B.E."
                    android:paddingStart="15dp"
                    android:paddingEnd="10dp"
                    android:textColor="#F5F7FF"
                    android:textColorHint="#555D73"
                    android:textSize="14sp"/>

            </LinearLayout>


            <Space
                android:layout_width="12dp"
                android:layout_height="1dp"/>


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.65"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="YEAR"
                    android:textColor="#6F7893"
                    android:textSize="10sp"
                    android:letterSpacing="0.1"/>

                <EditText
                    android:id="@+id/etYear"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/bg_login_input"
                    android:hint="2nd"
                    android:inputType="text"
                    android:paddingStart="15dp"
                    android:paddingEnd="10dp"
                    android:textColor="#F5F7FF"
                    android:textColorHint="#555D73"
                    android:textSize="14sp"/>

            </LinearLayout>

        </LinearLayout>


        <!-- Branch -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="BRANCH"
            android:textColor="#6F7893"
            android:textSize="10sp"
            android:letterSpacing="0.1"/>

        <EditText
            android:id="@+id/etBranch"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_login_input"
            android:hint="Computer Engineering"
            android:inputType="textCapSentences"
            android:paddingStart="17dp"
            android:paddingEnd="17dp"
            android:textColor="#F5F7FF"
            android:textColorHint="#555D73"
            android:textSize="14sp"/>


        <!-- Security -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:text="ACCOUNT SECURITY"
            android:textColor="#4D8DFF"
            android:textSize="10sp"
            android:letterSpacing="0.14"/>


        <!-- Password -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="PASSWORD"
            android:textColor="#6F7893"
            android:textSize="10sp"
            android:letterSpacing="0.1"/>

        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_login_input"
            android:hint="Create a password"
            android:inputType="textPassword"
            android:paddingStart="17dp"
            android:paddingEnd="17dp"
            android:textColor="#F5F7FF"
            android:textColorHint="#555D73"
            android:textSize="14sp"/>


        <!-- Confirm -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="CONFIRM PASSWORD"
            android:textColor="#6F7893"
            android:textSize="10sp"
            android:letterSpacing="0.1"/>

        <EditText
            android:id="@+id/etConfirmPassword"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_login_input"
            android:hint="Repeat your password"
            android:inputType="textPassword"
            android:paddingStart="17dp"
            android:paddingEnd="17dp"
            android:textColor="#F5F7FF"
            android:textColorHint="#555D73"
            android:textSize="14sp"/>


        <!-- Terms -->

        <CheckBox
            android:id="@+id/cbTerms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:buttonTint="#4D8DFF"
            android:text="I agree to the Terms of Service and Privacy Policy"
            android:textColor="#858DA5"
            android:textSize="12sp"/>


        <!-- Register -->

        <TextView
            android:id="@+id/btnRegister"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_login_primary"
            android:gravity="center"
            android:text="CREATE ACCOUNT  →"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"/>


        <!-- Existing account -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Already have an account? "
                android:textColor="#6F7893"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/tvLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Login"
                android:textColor="#4D8DFF"
                android:textSize="13sp"
                android:textStyle="bold"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>