<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080A12"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="32dp"
        android:paddingBottom="30dp">

        <!-- Brand -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.12"
            android:text="ANTICIAI"
            android:textColor="#F5F7FF"
            android:textSize="15sp"
            android:textStyle="bold"/>


        <!-- Heading -->

        <TextView
            android:id="@+id/tvWelcome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="55dp"
            android:text="Welcome back."
            android:textColor="#F5F7FF"
            android:textSize="34sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Continue your journey with AnticiAI."
            android:textColor="#858DA5"
            android:textSize="15sp"/>


        <!-- Email -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="38dp"
            android:text="EMAIL"
            android:textColor="#858DA5"
            android:textSize="10sp"
            android:letterSpacing="0.12"/>

        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_login_input"
            android:hint="you@example.com"
            android:inputType="textEmailAddress"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:textColor="#F5F7FF"
            android:textColorHint="#555D73"
            android:textSize="15sp"/>


        <!-- Password -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="PASSWORD"
            android:textColor="#858DA5"
            android:textSize="10sp"
            android:letterSpacing="0.12"/>

        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_login_input"
            android:hint="Enter your password"
            android:inputType="textPassword"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:textColor="#F5F7FF"
            android:textColorHint="#555D73"
            android:textSize="15sp"/>


        <!-- Forgot Password -->

        <TextView
            android:id="@+id/tvForgotPassword"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="12dp"
            android:text="Forgot password?"
            android:textColor="#4D8DFF"
            android:textSize="12sp"
            android:textStyle="bold"/>


        <!-- Login -->

        <TextView
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_login_primary"
            android:gravity="center"
            android:text="LOGIN  →"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"/>


        <!-- OR -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#22283A"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                android:text="OR"
                android:textColor="#555D73"
                android:textSize="10sp"
                android:letterSpacing="0.12"/>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#22283A"/>

        </LinearLayout>


        <!-- Google -->

        <TextView
            android:id="@+id/btnGoogle"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_social_button"
            android:gravity="center"
            android:text="G    Continue with Google"
            android:textColor="#F5F7FF"
            android:textSize="14sp"
            android:textStyle="bold"/>


        <!-- Apple -->

        <TextView
            android:id="@+id/btnApple"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_social_button"
            android:gravity="center"
            android:text="    Continue with Apple"
            android:textColor="#F5F7FF"
            android:textSize="14sp"
            android:textStyle="bold"/>


        <!-- Mobile -->

        <TextView
            android:id="@+id/btnMobile"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_social_button"
            android:gravity="center"
            android:text="☎    Continue with Mobile"
            android:textColor="#F5F7FF"
            android:textSize="14sp"
            android:textStyle="bold"/>


        <!-- Register -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Don't have an account? "
                android:textColor="#6F7893"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/tvRegister"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Create one"
                android:textColor="#4D8DFF"
                android:textSize="13sp"
                android:textStyle="bold"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>