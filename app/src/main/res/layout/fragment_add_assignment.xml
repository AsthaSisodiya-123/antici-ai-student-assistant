<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080A12"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- HEADER -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PERSONAL WORKSPACE"
            android:textColor="#6F7893"
            android:textSize="11sp"
            android:letterSpacing="0.12"
            android:fontFamily="sans" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="New assignment."
            android:textColor="#F5F7FF"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Add an assignment and let AnticiAI track it."
            android:textColor="#858DA5"
            android:textSize="14sp" />

        <!-- ASSIGNMENT TITLE -->

        <EditText
            android:id="@+id/etAssignmentTitle"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_main_card"
            android:hint="Assignment title"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:textColor="#F5F7FF"
            android:textColorHint="#6F7893"
            android:textSize="15sp" />

        <!-- SUBJECT -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="SUBJECT"
            android:textColor="#858DA5"
            android:textSize="11sp"
            android:letterSpacing="0.1" />

        <Spinner
            android:id="@+id/spinnerSubject"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_main_card"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <!-- PRIORITY -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="PRIORITY"
            android:textColor="#858DA5"
            android:textSize="11sp"
            android:letterSpacing="0.1" />

        <Spinner
            android:id="@+id/spinnerPriority"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_main_card"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <!-- DUE DATE -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="DUE DATE"
            android:textColor="#858DA5"
            android:textSize="11sp"
            android:letterSpacing="0.1" />

        <TextView
            android:id="@+id/tvDueDate"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_main_card"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="Select due date"
            android:textColor="#858DA5"
            android:textSize="15sp"
            android:clickable="true"
            android:focusable="true" />

        <!-- DESCRIPTION -->

        <EditText
            android:id="@+id/etDescription"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_main_card"
            android:gravity="top"
            android:hint="Assignment description"
            android:inputType="textMultiLine"
            android:padding="18dp"
            android:textColor="#F5F7FF"
            android:textColorHint="#6F7893"
            android:textSize="15sp" />

        <!-- BUTTON -->

        <Button
            android:id="@+id/btnAddAssignment"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:backgroundTint="#4D8DFF"
            android:text="ADD ASSIGNMENT"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>