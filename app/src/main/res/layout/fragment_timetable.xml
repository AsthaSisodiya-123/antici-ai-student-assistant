<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080A12"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- HEADER -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:letterSpacing="0.15"
            android:text="ACADEMIC SCHEDULE"
            android:textColor="#4D8DFF"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="Timetable."
            android:textColor="#F5F7FF"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Organize your weekly class schedule."
            android:textColor="#858DA5"
            android:textSize="12sp" />

        <!-- WEEK SUMMARY -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:background="@drawable/bg_prediction_card"
            android:orientation="horizontal"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CLASSES"
                    android:textColor="#69738D"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="18"
                    android:textColor="#F5F7FF"
                    android:textSize="22sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="THIS WEEK"
                    android:textColor="#69738D"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="05 DAYS"
                    android:textColor="#4D8DFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

        <!-- MONDAY -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="MONDAY"
            android:textColor="#69738D"
            android:textSize="9sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/mondayClass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_prediction_card"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="17dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10:00 AM — 11:00 AM"
                android:textColor="#4D8DFF"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Database Management Systems"
                android:textColor="#F5F7FF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Room 204"
                android:textColor="#858DA5"
                android:textSize="10sp" />

        </LinearLayout>

        <!-- TUESDAY -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="TUESDAY"
            android:textColor="#69738D"
            android:textSize="9sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/tuesdayClass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_main_card"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="17dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="09:00 AM — 10:00 AM"
                android:textColor="#4D8DFF"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/data_structures_algorithms"
                android:textColor="#F5F7FF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Room 301"
                android:textColor="#858DA5"
                android:textSize="10sp" />

        </LinearLayout>

        <!-- WEDNESDAY -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="WEDNESDAY"
            android:textColor="#69738D"
            android:textSize="9sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/wednesdayClass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_main_card"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="17dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="11:00 AM — 12:00 PM"
                android:textColor="#4D8DFF"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Core Java"
                android:textColor="#F5F7FF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Lab 02"
                android:textColor="#858DA5"
                android:textSize="10sp" />

        </LinearLayout>

        <!-- THURSDAY -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="THURSDAY"
            android:textColor="#69738D"
            android:textSize="9sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/thursdayClass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_main_card"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="17dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10:00 AM — 11:00 AM"
                android:textColor="#4D8DFF"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/artificial_intelligence_ml"
                android:textColor="#F5F7FF"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- FRIDAY -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="FRIDAY"
            android:textColor="#69738D"
            android:textSize="9sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/fridayClass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_main_card"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="17dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="09:00 AM — 10:00 AM"
                android:textColor="#4D8DFF"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Computer Networks"
                android:textColor="#F5F7FF"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- ADD CLASS -->

        <TextView
            android:id="@+id/btnAddClass"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="30dp"
            android:background="@drawable/bg_main_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="+ ADD NEW CLASS"
            android:textColor="#4D8DFF"
            android:textSize="10sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>