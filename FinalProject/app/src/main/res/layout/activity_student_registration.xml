<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_login_gradient"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:text="Student Registration"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:layout_marginBottom="20dp"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="20dp"
            android:elevation="8dp">

            <EditText
                android:id="@+id/etsrName"
                android:hint="Full Name"
                android:background="@drawable/bg_input"
                android:padding="14dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <EditText
                android:id="@+id/etsrEmail"
                android:hint="Email"
                android:inputType="textEmailAddress"
                android:background="@drawable/bg_input"
                android:padding="14dp"
                android:layout_marginTop="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <EditText
                android:id="@+id/etsrMobile"
                android:hint="Mobile Number"
                android:inputType="phone"
                android:maxLength="10"
                android:background="@drawable/bg_input"
                android:padding="14dp"
                android:layout_marginTop="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <!-- Gender -->
            <RadioGroup
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <RadioButton
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/srrbMale"
                    android:text="Male"/>

                <RadioButton
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/srrbFemale"
                    android:text="Female"
                    android:layout_marginStart="20dp"/>
            </RadioGroup>

            <EditText
                android:id="@+id/etsrDOB"
                android:hint="Date of Birth"
                android:focusable="false"
                android:background="@drawable/bg_input"
                android:padding="14dp"
                android:layout_marginTop="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <EditText
                android:id="@+id/etsrCollege"
                android:hint="College Name"
                android:background="@drawable/bg_input"
                android:padding="14dp"
                android:layout_marginTop="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <EditText
                android:id="@+id/etsrCourse"
                android:hint="Course / Branch"
                android:background="@drawable/bg_input"
                android:padding="14dp"
                android:layout_marginTop="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <EditText
                android:id="@+id/etsrYear"
                android:hint="Year of Study (1/2/3/4)"
                android:inputType="number"
                android:background="@drawable/bg_input"
                android:padding="14dp"
                android:layout_marginTop="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <EditText
                android:id="@+id/etsrUsername"
                android:hint="Username"
                android:background="@drawable/bg_input"
                android:padding="14dp"
                android:layout_marginTop="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <EditText
                android:id="@+id/etsrPassword"
                android:hint="Password"
                android:inputType="textPassword"
                android:background="@drawable/bg_input"
                android:padding="14dp"
                android:layout_marginTop="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <EditText
                android:id="@+id/etsrConfirmPassword"
                android:hint="Confirm Password"
                android:inputType="textPassword"
                android:background="@drawable/bg_input"
                android:padding="14dp"
                android:layout_marginTop="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <Button
                android:id="@+id/btnStudentRegister"
                android:text="Register as Student"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:backgroundTint="#2563EB"
                android:layout_marginTop="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
