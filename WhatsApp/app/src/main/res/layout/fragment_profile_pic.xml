<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:id="@+id/profilePicFragment"
    android:layout_height="match_parent"
    tools:context=".Fragments.ProfilePicFragment"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:layout_marginTop="100dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="7dp"
        android:layout_gravity="center_horizontal"
        android:background="@color/card">
    <FrameLayout
        android:layout_width="300dp"
        android:layout_height="360dp"
        android:id="@+id/profileFrameLayout"
        android:background="@color/card"
        >

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:orientation="vertical"
                >
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:id="@+id/ivProfilePicImage"
                    android:src="@drawable/account"
                    />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@color/card2"
                    android:gravity="center">
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/ivProfileBackpress"
                    android:layout_margin="5dp"
                    android:src="@drawable/arrow_back"
                    android:padding="7dp"
                    android:backgroundTint="@color/card"
                    android:background="@drawable/profile_shape_circle"
                    />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:text="hello"
                    android:id="@+id/tvProfilePicName"
                    android:fontFamily="@font/abhaya_libre"
                    android:textColor="@color/white"
                    android:textSize="25dp"
                    android:padding="5dp"
                    />
                </LinearLayout>
            </FrameLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="5dp"
                android:background="@color/white"
                android:layout_gravity="bottom"
                >
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/ivProfileMsg"
                    android:padding="7dp"
                    android:layout_marginLeft="60dp"
                    android:layout_gravity="start"
                    android:src="@drawable/chat"
                    android:backgroundTint="@color/card"
                    android:background="@drawable/profile_shape_circle"
                    />

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/ivProfileCall"
                    android:layout_marginLeft="80dp"
                    android:src="@drawable/call"
                    android:padding="7dp"
                    android:backgroundTint="@color/card"
                    android:background="@drawable/profile_shape_circle"
                    />
            </LinearLayout>

    </FrameLayout>
    </LinearLayout>
</LinearLayout>