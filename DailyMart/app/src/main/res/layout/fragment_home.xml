
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Fragment.HomeFragment"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/untitled"
    android:layout_weight="100">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="10"
        android:orientation="horizontal">
    <androidx.appcompat.widget.SearchView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:id="@+id/searchView"
        android:layout_margin="5dp"
        android:background="@drawable/search_view_bh"
        android:hint="Search"
        android:layout_weight="9"
        />
        <ImageView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/mic"
            android:id="@+id/ivMic"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:focusable="false"
        android:layout_marginTop="60dp"
        android:importantForAccessibility="no"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">


            <com.airbnb.lottie.LottieAnimationView
                android:layout_width="411dp"
                android:layout_height="195dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="5dp"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                app:lottie_rawRes="@raw/offer" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="  Recently view"
                android:textSize="25dp"
                android:fontFamily="serif"
                android:textStyle="bold"
                android:layout_marginTop="15sp"
                android:layout_marginStart="0sp"
                android:textColor="@color/black"
                android:background="@color/white"
                />

            <HorizontalScrollView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fillViewport="true"
                android:focusable="false"
                android:importantForAccessibility="no">

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/glHomeFragment"
                    android:padding="8dp"
                    android:orientation="horizontal"
                    android:rowCount="1"
                    />

            </HorizontalScrollView>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="  Product for you"
                android:textSize="25dp"
                android:fontFamily="serif"
                android:textStyle="bold"
                android:layout_marginTop="15sp"
                android:layout_marginStart="0sp"
                android:textColor="@color/black"
                android:background="@color/white"
                />

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/glHomeFragment1"
                    android:padding="8dp"
                    android:orientation="horizontal"
                    android:columnCount="2"
                    android:layout_marginLeft="10dp"
                    />


        </LinearLayout>

    </ScrollView>

    <LinearLayout
        android:id="@+id/tvNetworkStatus"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#D32F2F"
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:layout_gravity="bottom"
        >

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="You are offline"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:padding="8dp"
            android:layout_alignParentBottom="true"
            android:drawableStart="@drawable/baseline_language_24"/>


    </LinearLayout>
</FrameLayout>